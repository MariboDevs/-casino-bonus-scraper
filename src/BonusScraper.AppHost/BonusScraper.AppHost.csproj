  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BonusScraper.Migrator\BonusScraper.Migrator.csproj" />
    <ProjectReference Include="..\BonusScraper.Cli\BonusScraper.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.Seq" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>
</Project>
